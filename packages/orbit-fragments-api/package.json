{
  "name": "orbit-fragments-api",
  "version": "0.1.0",
  "description": "Typed declarations for the window.orbit API that Orbit fragments run against.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "orbit",
    "fragments"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
