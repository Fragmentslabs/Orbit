{
  "name": "orbit-monorepo",
  "private": true,
  "version": "0.1.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/react": "^18.3.31"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.30.1"
  },
  "scripts": {
    "desktop:dev": "npm run dev --workspace=@orbit/desktop",
    "desktop:build": "npm run build --workspace=@orbit/desktop",
    "desktop:build:linux": "npm run build:linux --workspace=@orbit/desktop",
    "desktop:build:mac": "npm run build:mac --workspace=@orbit/desktop",
    "desktop:build:windows": "npm run build:windows --workspace=@orbit/desktop",
    "desktop:build:windows:release": "npm run build:windows:release --workspace=@orbit/desktop",
    "desktop:build:all": "npm run desktop:build:linux && npm run desktop:build:mac && npm run desktop:build:windows:release",
    "mobile:dev": "npm run start --workspace=@orbit/mobile",
    "mobile:web": "npm run web --workspace=@orbit/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "getenv": "^2.0.0"
  }
}
