# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Root
node_modules
dist
dist-electron
dist-ssr
*.local

# Apps
apps/*/node_modules
apps/*/dist
apps/*/dist-electron
apps/*/.expo
# dictation whisper-server: source/build and the generated binary
# (apps/desktop/scripts/build-whisper-server.mjs)
apps/desktop/.whisper-build
apps/desktop/resources/whisper
# static ffmpeg/ffprobe of video editing (apps/desktop/scripts/fetch-ffmpeg.mjs)
apps/desktop/.ffmpeg-build
apps/desktop/resources/ffmpeg
# Bundled embedding model (npm run memory:bundle) — 139 MB, never commit
apps/desktop/resources/memory-embed
# Video/motion edit outputs: the edit/ folder the tools create next to the
# footage (renders, transcripts, contact sheets) is always generated, never authored.
edit/

# Packages
packages/*/node_modules
*.tsbuildinfo

# Claude local configuration
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

release

# AppX assets generated in build:store (scripts/generate-appx-assets.mjs)
apps/desktop/build/appx
apps/desktop/.cache

# Signing/notarization credentials. electron-builder reads electron-builder.env
# from its cwd, which is apps/desktop (see node_modules/electron-builder/out/cli/cli-util.js:24).
# The real file lives in the home directory; the one in here is a symlink — never commit.
apps/desktop/electron-builder.env
electron-builder.env
