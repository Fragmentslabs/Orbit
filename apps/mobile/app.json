{
  "expo": {
    "name": "Orbit",
    "slug": "fragments-labs",
    "version": "0.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "bundleIdentifier": "com.fragmentslabs.orbit",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "O Orbit precisa acessar dispositivos na mesma rede Wi-Fi para conectar ao Orbit Desktop."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#18181b",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "icon": "./assets/images/icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.fragmentslabs.orbit",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Orbit needs the microphone to dictate messages — the audio is turned into text on your computer and nothing is sent to the cloud.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Orbit needs camera access to scan the connection QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Orbit needs access to your photos to attach images to the chat.",
          "cameraPermission": "Orbit needs camera access to take photos and attach them to the chat."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#09090b",
          "sounds": [
            "./assets/sounds/notif.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee306300-6011-446b-a46e-e85ea6604c38"
      }
    },
    "owner": "fragmentslabs"
  }
}
