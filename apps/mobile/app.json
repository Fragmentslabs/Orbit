{
  "expo": {
    "name": "Orbit",
    "slug": "fragments-labs",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090c",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "O Orbit precisa acessar dispositivos na mesma rede Wi-Fi para conectar ao Orbit Desktop."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fragmentslabs.orbit",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#09090c"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "O Orbit precisa de acesso à câmera para escanear o QR code de conexão."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Orbit precisa acessar suas fotos para anexar imagens ao chat.",
          "cameraPermission": "O Orbit precisa de acesso à câmera para tirar fotos e anexar ao chat."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#09090c"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee306300-6011-446b-a46e-e85ea6604c38"
      }
    },
    "owner": "fragmentslabs"
  }
}
