{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@orbit/shared": ["../../packages/shared/src"],
      "@orbit/shared/*": ["../../packages/shared/src/*"],
      "@orbit/protocol": ["../../packages/protocol/src"],
      "@orbit/sdk": ["../../packages/sdk/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
