      { "label": "Subagents", "modes": ["Chat", "Code"], "description": "Ephemeral workers for parallel tasks.", "detail": "The agent delegates subtasks to background workers, discarded once the task ends.", "combo": ["Loop", "Orchestra"] },
      { "label": "Orchestra", "modes": ["Code"], "description": "Splits the request into a plan + persistent workers.", "detail": "The orchestrator plans, you approve, and each task becomes a child session in the right panel.", "combo": ["Loop", "Subagents"] },
      { "label": "Loop", "modes": ["Code"], "description": "Agent reviews and iterates until the task is done.", "detail": "After each reply, the system reviews the result. If incomplete, the agent continues automatically.", "combo": ["Subagents", "Orchestra", "Thinking"] },
      { "label": "Plan Mode", "modes": ["Code"], "description": "Read-only — produces a plan without editing.", "detail": "Blocks write tools. The agent reads the code and produces a detailed plan.", "combo": ["Thinking", "Research"] },
      { "label": "Permissions", "modes": ["Code"], "description": "Security control over the agent's actions.", "detail": "Three levels: Ask, Approve (summary), Full (automatic).", "combo": [] }
    ],
    "combos": [
