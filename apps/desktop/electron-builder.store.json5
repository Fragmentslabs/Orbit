// @see - https://www.electron.build/ms-windows#appx
// MSIX build for the Microsoft Store (Partner Center).
// Reserved identity: FragmentsLabs.OrbitCode (publisher CN=4E3E514F-094A-4537-AE9E-AF15CB35D52A)
// Usage: npm run build:store — requires Windows 10+ (on macOS it needs a Parallels VM with Windows)
// Without a configured certificate the package comes out unsigned: the Store signs it on ingestion.
//
// Output in release/store/, separate from the normal build: both use "win-unpacked"
// inside the output, and sharing the folder broke the second one to run — the
// electron-builder reused the directory, skipped the Electron extraction and
// failed to rename an electron.exe that the previous build had already renamed.
//
// The appx target here is NOT enough on its own: "extends" concatenates arrays, so the nsis
// of the parent would stay in the list. What restricts it is the `--win appx` of the script.
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "extends": "./electron-builder.json5",
  "directories": {
    "output": "release/store/${version}"
  },
  "win": {
    "target": [
      {
        "target": "appx",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Orbit-${version}.${ext}"
  },
  // The tiles come from build/appx/, generated by scripts/generate-appx-assets.mjs
  // in build:store. Without that folder the electron-builder uses the SampleAppx.*.png of the
  // winCodeSign vendor — the Electron logo — and that is how v0.1.0 shipped.
  "appx": {
    "displayName": "Orbit Code",
    // Tile frame: the same #18181B as the background of icon.png (the default is #464646)
    "backgroundColor": "#18181B",
    "identityName": "FragmentsLabs.OrbitCode",
    "publisher": "CN=4E3E514F-094A-4537-AE9E-AF15CB35D52A",
    "publisherDisplayName": "Fragments Labs",
    // First language = default language of the package
    "languages": [
      "en-US",
      "pt-BR"
    ]
  }
}