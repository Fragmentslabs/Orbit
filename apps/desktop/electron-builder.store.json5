// @see - https://www.electron.build/ms-windows#appx
// Build MSIX para a Microsoft Store (Partner Center).
// Identidade reservada: FragmentsLabs.OrbitCode (publisher CN=4E3E514F-094A-4537-AE9E-AF15CB35D52A)
// Uso: npm run build:store — requer Windows 10+ (no macOS exige VM Parallels com Windows)
// Sem certificado configurado o pacote sai sem assinatura: a Store assina na ingestão.
//
// Saída em release/store/, separada do build normal: os dois usam "win-unpacked"
// dentro do output, e compartilhar a pasta quebrava o segundo a rodar — o
// electron-builder reaproveitava o diretório, pulava a extração do Electron e
// falhava ao renomear um electron.exe que a build anterior já tinha renomeado.
//
// O alvo appx aqui NÃO basta sozinho: "extends" concatena arrays, então o nsis
// do pai continuaria na lista. Quem restringe é o `--win appx` do script.
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "extends": "./electron-builder.json5",
  "directories": {
    "output": "release/store/${version}"
  },
  "win": {
    "target": [
      {
        "target": "appx",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Orbit-${version}.${ext}"
  },
  // Os ladrilhos vêm de build/appx/, gerados por scripts/generate-appx-assets.mjs
  // no build:store. Sem essa pasta o electron-builder usa os SampleAppx.*.png do
  // vendor winCodeSign — o logo do Electron — e foi assim que a v0.1.0 subiu.
  "appx": {
    "displayName": "Orbit Code",
    // Moldura dos ladrilhos: mesmo #18181B do fundo do icon.png (o padrão é #464646)
    "backgroundColor": "#18181B",
    "identityName": "FragmentsLabs.OrbitCode",
    "publisher": "CN=4E3E514F-094A-4537-AE9E-AF15CB35D52A",
    "publisherDisplayName": "Fragments Labs",
    // Primeiro idioma = idioma padrão do pacote
    "languages": [
      "en-US",
      "pt-BR"
    ]
  }
}