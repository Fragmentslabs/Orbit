// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.fragmentslabs.orbit.code",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/node_modules/node-pty/**",
    "**/node_modules/pdf-parse/**",
    "**/node_modules/pdfjs-dist/**",
    "**/node_modules/@napi-rs/canvas*/**",
    // Local TTS runtime: it has a native binary (.node) and the libonnxruntime
    // (.dylib/.so/.dll) next to it — none of that loads from inside the asar.
    "**/node_modules/onnxruntime-node/**",
    // Dictation engine (Parakeet): the N-API addon of sherpa-onnx comes in a package
    // per platform (sherpa-onnx-darwin-arm64 etc.), with .node and dylibs.
    "**/node_modules/sherpa-onnx-*/**"
  ],
  "productName": "Orbit",
  "directories": {
    "output": "release/${version}"
  },
  "icon": "public/icon.png",
  "files": [
    "dist",
    "dist-electron",
    // Voice engine (TTS): it goes AS IS, outside the main bundle — the child
    // process loads it by path, and only the code (MIT) enters here: the weights are
    // downloaded to userData, never packaged.
    "electron/voice-engine/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/node-pty/**/*",
    "node_modules/pdf-parse/**/*",
    "node_modules/pdfjs-dist/**/*",
    "node_modules/@napi-rs/canvas*/**/*",
    // Dependencies of the voice engine. They stay in node_modules/ because the child
    // process resolves them by name, from the folder of the engine.
    "node_modules/onnxruntime-node/**/*",
    "node_modules/onnxruntime-common/**/*",
    // Dictation (Parakeet). Without these the `voice:status` reports the engine as
    // unavailable and the microphone can only send to the Preferences.
    "node_modules/sherpa-onnx-node/**/*",
    "node_modules/sherpa-onnx-*/**/*"
  ],
  "extraResources": [
    {
      "from": "assets/sounds",
      "to": "sounds"
    },
    // Dictation whisper-server (Whisper engine), one per platform/architecture:
    // generated by `npm run whisper:build` before electron-builder.
    {
      "from": "resources/whisper/${platform}-${arch}",
      "to": "whisper"
    },
    // Static ffmpeg + ffprobe for the agent's video editing, one pair per
    // platform/architecture: downloaded by `npm run ffmpeg:fetch` before
    // electron-builder (scripts/fetch-ffmpeg.mjs).
    {
      "from": "resources/ffmpeg/${platform}-${arch}",
      "to": "ffmpeg",
      "filter": ["ffmpeg*", "ffprobe*"]
    },
    // Memory embedding model (Bekko a8m, ~139 MB): it goes INSIDE the app
    // so that the semantic search works from the first open, without download,
    // without screen and without network failure. Prepared by `npm run memory:bundle`
    // before electron-builder (scripts/bundle-memory-model.mjs).
    //
    // It is not per architecture: the weights are the same on arm64 and x64, so one
    // copy serves both installers. And since the bytes do not change
    // between releases, the differential update of the updater does not re-download these
    // blocks.
    {
      "from": "resources/memory-embed",
      "to": "memory-embed"
    }
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
    // The provisioningProfile (Mac App Store) is injected via CLI in the build:mas/upload:mas scripts —
    // here it would end up in the direct distribution build (DMG), which needs the Developer ID, not the MAS.
    "icon": "build/icon.icns",
    "minimumSystemVersion": "12.0.0",
    "bundleVersion": "3",
    // Camera/microphone/location requested by the sites of the built-in browser
    // (browser-permissions.ts): macOS requires the usage text in Info.plist and the
    // entitlement in the hardened runtime, otherwise it denies without asking.
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "ITSAppUsesNonExemptEncryption": false,
      "NSCameraUsageDescription": "Sites opened in the Orbit browser may ask for the camera (video calls, QR code scanning).",
      "NSMicrophoneUsageDescription": "Sites opened in the Orbit browser may ask for the microphone (video calls, audio recording).",
      "NSLocationWhenInUseUsageDescription": "Sites opened in the Orbit browser may ask for your location.",
      "NSLocationUsageDescription": "Sites opened in the Orbit browser may ask for your location."
    }
  },
  // Mac App Store: its own entitlements (sandbox). Explicit so that they do not
  // inherit the ones of the "mac" above, which are from the hardened runtime without sandbox.
  "mas": {
    "entitlements": "build/entitlements.mas.plist",
    "entitlementsInherit": "build/entitlements.mas.inherit.plist"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Development",
    // In electron-builder 26 the default of executableName on Linux stopped being the productName
    // and started deriving from the `name` of the package ("@orbit/desktop" -> "@orbitdesktop"), which the
    // AppImage target rejects (it only accepts letters, digits, dot, underscore, hyphen and space).
    // Explicit to keep the name of the previous releases.
    "executableName": "Orbit",
    // The Linux icon comes from here; electron-builder generates the sizes and
    // installs them as /usr/share/icons/hicolor/<size>/apps/Orbit.png, which is the
    // name the Icon= key of the .desktop references (executableName).
    "icon": "build/icon.png",
    // Electron takes the app_id (WM_CLASS) from the `desktopName` of package.json, and
    // with this the installed .desktop ends up with the SAME name and the same
    // StartupWMClass. Without that match the environment does not link the open window
    // to the shortcut, and the dock shows a generic icon instead of the app's — it was
    // what happened in the AppImage.
    "syncDesktopName": true,
    // TODO: replace with the maintainer's real e-mail
    "maintainer": "Orbit <orbit@fragmentslabs.com>",
    // Version-less name so the "latest/download" release URL stays stable
    // (e.g. Orbit-Linux-x64.AppImage → .../releases/latest/download/Orbit-Linux-x64.AppImage)
    "artifactName": "${productName}-Linux-${arch}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "Fragmentslabs",
    "repo": "Orbit",
    // The electron-builder default is "draft": if the tag's release is already published,
    // the publisher considers the types incompatible and SKIPS the upload without failing (green run,
    // no artifact) — it is what happened in the 0.1.3 Linux release.
    "releaseType": "release"
  }
}
