// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.fragmentslabs.orbit.code",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/node_modules/node-pty/**",
    "**/node_modules/pdf-parse/**",
    "**/node_modules/pdfjs-dist/**",
    "**/node_modules/@napi-rs/canvas*/**"
  ],
  "productName": "Orbit",
  "directories": {
    "output": "release/${version}"
  },
  "icon": "public/icon.png",
  "files": [
    "dist",
    "dist-electron",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/node-pty/**/*",
    "node_modules/pdf-parse/**/*",
    "node_modules/pdfjs-dist/**/*",
    "node_modules/@napi-rs/canvas*/**/*"
  ],
  "extraResources": [
    {
      "from": "assets/sounds",
      "to": "sounds"
    }
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "artifactName": "${productName}-Mac-${version}-${arch}.${ext}",
    // O provisioningProfile (Mac App Store) é injetado via CLI nos scripts build:mas/upload:mas —
    // aqui ele ficaria no build de distribuição direta (DMG), que precisa do Developer ID, não do MAS.
    "icon": "build/icon.icns",
    "minimumSystemVersion": "12.0.0",
    "bundleVersion": "3",
    // Câmera/microfone/localização pedidos pelos sites do navegador integrado
    // (browser-permissions.ts): o macOS exige o texto de uso no Info.plist e o
    // entitlement no hardened runtime, senão nega sem perguntar.
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "ITSAppUsesNonExemptEncryption": false,
      "NSCameraUsageDescription": "Sites abertos no navegador do Orbit podem pedir a câmera (videochamadas, leitura de QR code).",
      "NSMicrophoneUsageDescription": "Sites abertos no navegador do Orbit podem pedir o microfone (videochamadas, gravação de áudio).",
      "NSLocationWhenInUseUsageDescription": "Sites abertos no navegador do Orbit podem pedir sua localização.",
      "NSLocationUsageDescription": "Sites abertos no navegador do Orbit podem pedir sua localização."
    }
  },
  // Mac App Store: entitlements próprios (sandbox). Explícitos para não
  // herdarem os do "mac" acima, que são do hardened runtime sem sandbox.
  "mas": {
    "entitlements": "build/entitlements.mas.plist",
    "entitlementsInherit": "build/entitlements.mas.inherit.plist"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Development",
    // No electron-builder 26 o default de executableName no Linux deixou de ser o productName
    // e passou a derivar do `name` do pacote ("@orbit/desktop" -> "@orbitdesktop"), que o
    // target AppImage rejeita (so aceita letras, digitos, ponto, underscore, hifen e espaco).
    // Explicito para manter o nome dos releases anteriores.
    "executableName": "Orbit",
    // O icone do Linux vem daqui; o electron-builder gera os tamanhos e os
    // instala como /usr/share/icons/hicolor/<tamanho>/apps/Orbit.png, que e o
    // nome que a chave Icon= do .desktop referencia (executableName).
    "icon": "build/icon.png",
    // O Electron tira o app_id (WM_CLASS) do `desktopName` do package.json, e
    // com isto o .desktop instalado passa a ter o MESMO nome e o mesmo
    // StartupWMClass. Sem esse casamento o ambiente nao liga a janela aberta
    // ao atalho, e o dock mostra um icone generico em vez do do app — era o
    // que acontecia no AppImage.
    "syncDesktopName": true,
    // TODO: trocar pelo e-mail real do mantenedor
    "maintainer": "Orbit <orbit@fragmentslabs.com>",
    // Version-less name so the "latest/download" release URL stays stable
    // (e.g. Orbit-Linux-x64.AppImage → .../releases/latest/download/Orbit-Linux-x64.AppImage)
    "artifactName": "${productName}-Linux-${arch}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "Fragmentslabs",
    "repo": "Orbit",
    // O default do electron-builder e "draft": se a release do tag ja existe publicada,
    // o publisher considera os tipos incompatíveis e PULA o upload sem falhar (run verde,
    // artefato nenhum) — foi o que aconteceu no release de Linux da 0.1.3.
    "releaseType": "release"
  }
}
