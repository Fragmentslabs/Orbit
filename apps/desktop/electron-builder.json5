// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "electronVersion": "30.0.1",
  "appId": "com.fragmentslabs.orbit.code",
  "asar": true,
  "asarUnpack": [
    "**/node_modules/sharp/**",
    "**/node_modules/@img/**",
    "**/node_modules/node-pty/**",
    "**/node_modules/pdf-parse/**",
    "**/node_modules/pdfjs-dist/**",
    "**/node_modules/@napi-rs/canvas*/**"
  ],
  "productName": "Orbit",
  "directories": {
    "output": "release/${version}"
  },
  "icon": "public/icon.png",
  "files": [
    "dist",
    "dist-electron",
    "node_modules/sharp/**/*",
    "node_modules/@img/**/*",
    "node_modules/node-pty/**/*",
    "node_modules/pdf-parse/**/*",
    "node_modules/pdfjs-dist/**/*",
    "node_modules/@napi-rs/canvas*/**/*"
  ],
  "extraResources": [
    {
      "from": "assets/sounds",
      "to": "sounds"
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "artifactName": "${productName}-Mac-${version}.${ext}",
    // O provisioningProfile (Mac App Store) é injetado via CLI nos scripts build:mas/upload:mas —
    // aqui ele ficaria no build de distribuição direta (DMG), que precisa do Developer ID, não do MAS.
    "icon": "build/icon.icns",
    "minimumSystemVersion": "12.0.0",
    "bundleVersion": "3",
    "extendInfo": {
      "ITSAppUsesNonExemptEncryption": false
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Development",
    // TODO: trocar pelo e-mail real do mantenedor
    "maintainer": "Orbit <orbit@fragmentslabs.com>",
    // Version-less name so the "latest/download" release URL stays stable
    // (e.g. Orbit-Linux-x64.AppImage → .../releases/latest/download/Orbit-Linux-x64.AppImage)
    "artifactName": "${productName}-Linux-${arch}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "Fragmentslabs",
    "repo": "Orbit"
  }
}
