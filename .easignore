# EAS archive exclusions (monorepo root)
# only the Android app + workspace packages are needed to build the mobile APK

apps/desktop
docs
.claude
.tmp*
release
*.log
bf2*

# dependencies (hoisted at the root + per app)
node_modules

# generated native projects — EAS runs prebuild (CNG); /ios and /android are gitignored
apps/mobile/ios
apps/mobile/android

# estado local do Expo e artefatos TS
apps/mobile/.expo
.expo-export-check/
*.tsbuildinfo
